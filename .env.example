# Newsletter signup (app/api/newsletter/route.ts)
# Copy this file to .env.local and fill in real values — .env.local is gitignored
# and is never committed. Without these set, the newsletter API returns a 503
# and no email is sent.

# SMTP credentials for the account that will SEND the signup notification.
# Any SMTP provider works (Gmail with an App Password, Zoho, SendGrid SMTP, your host's SMTP, etc).
SMTP_HOST=
SMTP_PORT=587
# Set to "true" if using port 465 (implicit TLS). Leave unset/"false" for port 587 (STARTTLS).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Optional: "From" address shown on the notification email. Defaults to SMTP_USER if unset.
SMTP_FROM=

# Optional: override the destination inbox for signup notifications.
# Defaults to ingerkmoore247@gmail.com if unset.
NEWSLETTER_TO_EMAIL=ingerkmoore247@gmail.com
